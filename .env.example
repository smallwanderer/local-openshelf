# =============================================================================
# 서버 구동 관련 설정
# =============================================================================
# python install.py로 .env를 처음 생성하면 랜덤 값으로 자동 채워집니다.
# 이 파일을 직접 복사해 .env를 만드는 경우에는 반드시 고유한 값으로 바꾸세요.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_TIME_ZONE=Asia/Seoul
DJANGO_LANGUAGE_CODE=ko-kr

# 0: 로그인 없이 로컬 관리자 프로필로 자동 접속 (외부 접속이 없는 개인 사용 기본값)
# 1: 실제 로그인을 요구 (외부에서 접속 가능한 배포에서 사용)
# 값을 바꾼 뒤에는 재시작해야 적용됩니다: python install.py --login enable|disable
LOGIN_REQUIRED=0

# 0으로 설정하면 root URL을 기존 Django template UI(`/files/`)로 즉시 되돌립니다.
DOTORI_SPA_ENABLED=1

# Django 변경 요청의 Origin 검사 허용 목록입니다. 4173은 로컬 Vite 개발 서버용이며,
# 외부 배포에서는 실제 HTTPS origin으로 교체하세요.
DOTORI_DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:4173,http://127.0.0.1:4173

# Hugging Face 토큰 (필수는 아니지만, 일부 모델 다운로드 시 필요합니다)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 서버를 실행 후 변경이 어렵습니다.
# PASSWORD는 .env를 생성할 때 자동으로 무작위 값으로 생성됩니다.
POSTGRES_DB=dotori
POSTGRES_USER=dotori
POSTGRES_PASSWORD=change-me

# POSTGRES_HOST/PORT는 docker-compose 네트워크의 서비스명에 고정된 값이므로 바꾸지 마세요.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Message Broker
CELERY_BROKER_URL=redis://redis:6379/0

# Media and Static File Storage
MEDIA_ROOT=/data/uploads
MEDIA_URL=/media/


# =============================================================================
# Parser & Chunker 설정 제어
# Note: 활성 임베딩 모델, 토크나이저 및 max_tokens는 런타임 계약
# (data/config/runtime_scopes/production/embedding_runtime.json)에서 동적으로 해결됩니다.
# =============================================================================
# 문서 파싱에 사용할 backend. registry에 등록된 것만 지정 가능 (현재는 docling뿐).
DOCUMENT_PARSER_BACKEND=docling

# 청킹 시 임베딩 상한선과의 안전 완충 마진
EMBEDDING_TOKEN_HEADROOM=128

# 런타임 파일이 누락되었을 때의 비상 Fallback 값들 (보통은 변경할 필요 없음)
# PARSER_TOKENIZER_ID=BAAI/bge-m3
# PARSER_TOKENIZER_REVISION=5617a9f
# EMBEDDING_MAX_TOKENS=1280


# =============================================================================
# 검색 품질 튜닝 섹션
# =============================================================================
EMBEDDING_DOC_POOLING_METHOD=normalized_logsumexp   # pooling [normalized_logsumexp, max]
EMBEDDING_DOC_POOL_TAU=10.0         # normalized_logsumexp pooling 온도 (1~20, 높을 수록 max-pooling에 가까워짐)
# dense, sparse 검색 가중치 (합계 = 1.0 권장)
EMBEDDING_HYBRID_DENSE_WEIGHT=0.7
EMBEDDING_HYBRID_SPARSE_WEIGHT=0.3
EMBEDDING_HYBRID_CANDIDATE_MULTIPLIER=12    # dense 1차 후보 = top_k × candidate_multiplier
EMBEDDING_PER_NODE_CANDIDATE_CAP=4  # 문서당 dense 후보 최대 허용 개수
EMBEDDING_QUERY_SPARSE_TOP_N=32     # 쿼리 sparse 벡터에서 상위 N개 토큰만 사용
EMBEDDING_EVIDENCE_TOP_K=3          # 최종 결과에 포함할 evidence 청크 수
EMBEDDING_DOC_POOL_TOP_K=5          # 문서 점수 pooling 에 사용할 청크 수
EMBEDDING_DOC_LENGTH_PENALTY_ALPHA=0.0      # 문서 길이 패널티 강도 (0 = 패널티 없음)
EMBEDDING_EVIDENCE_CONTEXT_WINDOW=1         # evidence 에 인접 청크 몇 개를 포함할지 (0 = 해당 청크만)

# 검색/RAG contextual compression: 검색된 chunk 내부에서 질문 관련 segment만 추출
CONTEXTUAL_COMPRESSION_ENABLED=0
CONTEXTUAL_COMPRESSION_WINDOW_SIZE=2
CONTEXTUAL_COMPRESSION_MAX_SEGMENTS_PER_CHUNK=16
CONTEXTUAL_COMPRESSION_TOP_SEGMENTS=3
CONTEXTUAL_COMPRESSION_MAX_CHARS=700
CONTEXTUAL_COMPRESSION_MIN_SCORE=0.1
CONTEXTUAL_COMPRESSION_DENSE_WEIGHT=0.4
CONTEXTUAL_COMPRESSION_SPARSE_WEIGHT=0.6


# =============================================================================
# Query Understanding Tuning 섹션
# 실험적 단계이므로 사용을 권장하지 않습니다.
# =============================================================================
QUERY_UNDERSTANDING_PIPELINE_ENABLED=0
QUERY_UNDERSTANDING_PIPELINE_MAX_VALIDATION_PASSES=2
QUERY_UNDERSTANDING_LLM_ENABLED=0
QUERY_UNDERSTANDING_PARSER_INCLUDE_METADATA=1
QUERY_UNDERSTANDING_SEMAPHORE_COUNT=1
QUERY_UNDERSTANDING_SEMAPHORE_TIMEOUT=180
QUERY_UNDERSTANDING_MAX_TOKENS=512
QUERY_UNDERSTANDING_REQUEST_TIMEOUT=60
QUERY_UNDERSTANDING_TEMPERATURE=0.0
QUERY_UNDERSTANDING_TOP_P=1.0


# =============================================================================
# 로컬 RAG 모델 전용 상세 기능 제어 옵션
# =============================================================================
RAG_LLM_URL=http://rag-runtime:8080     # 로컬 LLM Endpoint 기본값
RAG_MAX_TOKENS=2048                     # 답변 생성 최대 토큰 수
RAG_REQUEST_TIMEOUT=300                 # 답변 생성 타임아웃
GUNICORN_TIMEOUT=360                    # ASGI worker 장애 감지 타임아웃
WEB_CONCURRENCY=2                       # 가벼운 웹 프로세스 수 (RAG 동시성과 별개)
RAG_EXTERNAL_LLM_CONCURRENCY=4          # 외부 LLM endpoint별 동시 요청 상한
RAG_SEARCH_TOP_K=3                      # RAG 근거 검색 결과 상위 K개
RAG_RETRIEVAL_THRESHOLD=0.25            # RAG 근거 검색 결과 임계값
RAG_EVIDENCE_LIMIT=3                    # RAG 근거 제공 청크의 개수
RAG_CONTEXT_MAX_CHARS=3000              # RAG 답변 생성을 위한 근거로 사용될 최대 글자 수
RAG_EVIDENCE_TEXT_MAX_CHARS=500         # 청크 당 프롬프트에 포함되는 최대 글자 수
RAG_TEMPERATURE=0.2                     # LLM 생성 온도
RAG_TOP_P=0.9                           # LLM 샘플링 상위 누적 확률 범위


# =============================================================================
# Email / SMPT 제어
# =============================================================================
REQUIRE_EMAIL_VERIFICATION=1
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# SMTP 사용 시 아래 항목 설정 (console 백엔드일 때는 무시됨)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=change-me



# =============================================================================
# 수동 문서 파이프라인 복구 제어 섹션
# =============================================================================
DOCUMENT_AI_RECOVERY_STALE_MINUTES=30           # 작업이 중지된 태스크의 대기 시간 (분)
DOCUMENT_AI_RECOVERY_PARSE_BATCH_SIZE=50        # repair 명령당 파싱 재큐잉 최대 건수
DOCUMENT_AI_RECOVERY_EMBED_BATCH_SIZE=200       # repair 명령당 임베딩 재큐잉 최대 청크 수
DOCUMENT_AI_MAX_RECOVERY_ATTEMPTS=5             # 복구 재시도 최대 횟수 (초과 시 영구 제외)
PARSE_WORKER_CONCURRENCY=1                      # parse 전용 Celery worker 동시 실행 수
EMBEDDING_WORKER_CONCURRENCY=1                  # embed 전용 Celery worker 동시 실행 수
PARSE_WORKER_CPU_SHARES=256                     # parse worker 상대 CPU 우선순위
EMBEDDING_WORKER_CPU_SHARES=256                 # embed worker 상대 CPU 우선순위
EMBEDDING_MODEL_CPU_SHARES=256                  # BGE-M3 모델 HTTP 프로세스 상대 CPU 우선순위
# embed 큐에 이 수만큼 작업이 대기하면 parse 작업은 파일을 열기 전에 재시도합니다.
# Redis 점검 실패 시에는 업로드 중단을 피하기 위해 fail-open으로 계속 파싱합니다.
DOCUMENT_AI_EMBED_QUEUE_BACKPRESSURE_LIMIT=32
DOCUMENT_AI_PARSE_BACKPRESSURE_RETRY_SECONDS=5

# BGE-M3는 embedding-executor의 모델 소유 프로세스에서만 로드됩니다. app과
# embedding-executor-consumer는 둘 다 이 포트로 쿼리/문서 임베딩을 원격
# 호출합니다(RemoteBGEM3Provider).
EMBEDDING_SERVICE_PORT=8001                     # embedding-executor 내부 임베딩 HTTP 포트 (호스트에 노출되지 않음)
EMBEDDING_SERVICE_TIMEOUT=60                    # app -> embedding-executor 임베딩 요청 타임아웃 (초)
EMBEDDING_BATCH_SERVICE_TIMEOUT=180             # 문서 배치 전용 타임아웃 (초, CPU 추론 고려)
                                                 # 재시작 후 첫 호출은 BGE-M3 최초 로드 때문에 수십 초가 걸릴 수 있습니다.
# install.py가 최초 설치 시 무작위로 생성합니다. app과 embedding-executor 사이의
# 내부 /embed/ 호출에만 쓰이며 브라우저에는 절대 전달되지 않습니다.
EMBEDDING_INTERNAL_TOKEN=change-me
# Optional dedicated token; when omitted, uses the generated EMBEDDING_INTERNAL_TOKEN.
# EXECUTOR_INTERNAL_TOKEN=
# /embed/에서 동시에 허용할 model.encode() 호출 수. BGE-M3 동시 encode()의 스레드
# 안전성은 `manage.py check_embedding_concurrency`로 검증되었습니다.
EMBEDDING_MODEL_CONCURRENCY=2
# 모델 진입 대기열은 query를 document보다 먼저 처리하고, 같은 종류는 FIFO입니다.
# 실행 중인 encode는 선점하지 않습니다. document가 대기열 전체를 채우지 못하도록
# query 전용 자리를 최소 1개 남깁니다.
EMBEDDING_REQUEST_QUEUE_CAPACITY=4
EMBEDDING_QUERY_QUEUE_RESERVE=1
EMBEDDING_REQUEST_QUEUE_TIMEOUT_SECONDS=15
# 같은 문서의 청크를 한 번의 model.encode() 호출로 묶는 마이크로배치 상한입니다.
# 쿼리 임베딩은 절대 배치하지 않습니다(지연 민감, 항상 단건). 개수/토큰 예산 중
# 먼저 도달하는 쪽에서 배치가 끊깁니다 -- 배치가 클수록 그 사이 도착한 쿼리가
# admission 슬롯을 더 오래 기다리게 되므로 처리량뿐 아니라 이 대기시간도 고려해
# 값을 정하세요.
EMBEDDING_DOCUMENT_BATCH_MAX_CHUNKS=4
EMBEDDING_DOCUMENT_BATCH_MAX_TOKENS=3200
# 실행 슬롯과 대기 요청, healthcheck를 함께 받을 HTTP 스레드 수입니다. 모델은 gunicorn
# worker 1개에만 로드해야 하므로 --workers는 늘리지 않습니다.
EMBEDDING_HTTP_THREADS=8
# 문서 AI 컨테이너의 상대적 CPU 우선순위(Docker --cpu-shares, 기본값 1024).
# app/dotori-llm 컨테이너는 이 값을 지정하지 않아 기본 1024를 유지하므로, 값을 낮출수록
# CPU 경합(파싱/임베딩+LLM 생성이 동시에 몰릴 때) 상황에서 문서 AI가 손해를 보고
# app/LLM 쪽에 더 많은 CPU 시간이 배분됩니다. 호스트가 한가할 땐 이 값과 무관하게
# 각 프로세스가 코어를 자유롭게 씁니다(하드 상한이 아님).


# =============================================================================
# Logging
# =============================================================================
# 컨테이너 기준 로그 저장 경로입니다. docker-compose에서 ./data/logs 로 마운트됩니다.
LOG_DIR=/data/logs
OPERATION_LOG_LEVEL=WARNING         # 운영 문제 확인: operations.{SERVICE_NAME}.log
DOCUMENT_AI_LOG_LEVEL=INFO          # AI 파이프라인 흐름 확인: document_ai.{SERVICE_NAME}.log
# app/embedding-executor가 ./data/logs를 공유 마운트하므로, 같은 파일에 동시에 쓰지
# 않도록 서비스별로 로그 파일명을 분리한다. docker-compose.yml이 서비스마다 지정하며,
# 로컬에서 직접 실행할 때만 이 기본값(app)이 쓰인다.
SERVICE_NAME=app
DOTORI_OPERATION_MODE=rag



# ============================================================================
# Depricated!!! - 현재는 사용하지 않는 설정값입니다
# ============================================================================

# [Deprecated] 별도 query-parser 런타임을 쓰던 시절의 설정입니다. (실험적 기능)
# 코드 상으로는 존재하지만 실제 서비스에서는 호스트가 존재하지 않습니다.
# QUERY_UNDERSTANDING_FRONTEND_MODE=passthrough
# QUERY_UNDERSTANDING_PARSER_BASE_URL=http://rag-runtime:8080
# QUERY_UNDERSTANDING_PARSER_REQUEST_MODEL=query-parser
# QUERY_UNDERSTANDING_PARSER_MODEL=meta-llama/Llama-3.2-3B-Instruct
# QUERY_UNDERSTANDING_PARSER_SERVED_MODEL_NAME=meta-llama/Llama-3.2-3B-Instruct
# QUERY_UNDERSTANDING_RUNTIME_VLLM_MAX_MODEL_LEN=2048
# QUERY_UNDERSTANDING_RUNTIME_VLLM_DTYPE=bfloat16
# QUERY_UNDERSTANDING_RUNTIME_VLLM_CPU_KVCACHE_SPACE=2
# QUERY_UNDERSTANDING_RUNTIME_VLLM_CPU_OMP_THREADS_BIND=auto
# QUERY_UNDERSTANDING_RUNTIME_VLLM_CPU_NUM_OF_RESERVED_CPU=1
